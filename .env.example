# ============================================================
# PETID AGENT v2.0 - Variables de Entorno
# Copia este archivo como .env y rellena los valores
# ============================================================

# Puerto del servidor API del agente
PORT=3002
NODE_ENV=development

# ------ LLM: Cerebras API ------
CEREBRAS_API_KEY=csk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
CEREBRAS_MODEL=llama3.1-8b

# ------ TELEGRAM BOT ------
TELEGRAM_BOT_TOKEN=xxxxxxxx:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Modo polling (dev) o webhook (prod)
TELEGRAM_MODE=polling
# URL para webhook en producción (ej: https://tu-app.railway.app)
TELEGRAM_WEBHOOK_URL=

# IDs de grupos de Telegram donde el bot publicará alertas (separados por coma)
# Para obtener el ID: agrega @raw_data_bot a tu grupo y envía un mensaje
TELEGRAM_GROUP_IDS=

# ------ DISCORD BOT ------
# Obtener en https://discord.com/developers/applications
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
# ID del servidor de Syscoin (opcional, para registrar comandos solo allí)
DISCORD_GUILD_ID=
# IDs de canales permitidos, separados por coma (opcional)
DISCORD_CHANNEL_IDS=

# ------ PETID APP API ------
# URL del backend de 1_APP_MASCOTAS
PETID_API_URL=http://localhost:3001

# ------ BASE DE DATOS (opcional) ------
DATABASE_URL=postgresql://petid:petid@localhost:5432/petid_agent
DATABASE_SSL=false

# ------ SUPERDAPP SYSCOIN ------
SUPERDAPP_API_URL=https://api.superdapp.io
SUPERDAPP_API_KEY=

# ------ OPENCLAW ------
OPENCLAW_REGISTRY_URL=https://registry.openclaw.io
OPENCLAW_AGENT_ID=

# ------ BLOCKCHAIN zkTanenbaum (zkSYS Testnet) ------
RPC_URL=https://rpc-zk.tanenbaum.io
CHAIN_ID=57057
CONTRACT_ADDRESS=0x7Ff5e0f9c8bb86422D5d1a6560b8cD67e8d99289
EXPLORER_URL=https://explorer-zk.tanenbaum.io
# Private key del agente para escribir on-chain (opcional, modo read-only sin ella)
AGENT_PRIVATE_KEY=
